{
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "missing": [
        { "type": "host", "value": "overheid-amrp.vercel.app" }
      ],
      "destination": "https://overheid-amrp.vercel.app/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:portalPath*",
      "destination": "/api/portal?__portal_route=/auth/:portalPath*"
    },
    {
      "source": "/api/:portalPath*",
      "destination": "/api/portal?__portal_route=/api/:portalPath*"
    }
  ],
  "crons": [
    { "path": "/api/cron/discord-sync", "schedule": "0 4 * * *" }
  ]
}
