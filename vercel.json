{
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "functions": {
    "api/**/*.mjs": { "includeFiles": "server/certs/**" }
  },
  "redirects": [
    {
      "source": "/admin",
      "destination": "/login.html?beheer=1",
      "permanent": false
    },
    {
      "source": "/admin/",
      "destination": "/login.html?beheer=1",
      "permanent": false
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "overheid-amrp.vercel.app" }],
      "destination": "https://overheid.amsterdamrp.nl/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/auth/:portalPath*",
      "destination": "/api/portal?__portal_route=/auth/:portalPath*"
    },
    {
      "source": "/api/:portalPath*",
      "destination": "/api/portal?__portal_route=/api/:portalPath*"
    }
  ],
  "crons": [{ "path": "/api/cron/discord-sync", "schedule": "0 4 * * *" }]
}
