NODE_ENV=production
PORT=4400
HOST=0.0.0.0
APP_ORIGIN=https://overheid.jouwdomein.nl
DATA_DIR=./data
# Vercel injects POSTGRES_URL and BLOB_READ_WRITE_TOKEN when storage is connected.
# Use DATABASE_URL if your PostgreSQL integration provides that name instead.
POSTGRES_URL=
DATABASE_URL=
CRON_SECRET=
INITIAL_SETUP_KEY=
# Genereer: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_BOT_TOKEN=
DISCORD_GUILD_ID=
# Exacte terugkeer-URL: https://overheid.jouwdomein.nl/auth/discord/callback
# Meerdere rol-ID's scheiden met een komma. Geen rolnamen gebruiken.
ROLE_ADMIN=1519394041165516911
ROLE_OWNER=1519394039361835239,1519394037423931392
# De login accepteert politie en korpsleiding; vul de aparte ambulancerol in als die bestaat.
ROLE_POLICE=1519394082277953679
ROLE_COMMAND=1519394051760066660
ROLE_AMBULANCE=
# Optioneel: lees uitsluitend een actief roepnummer vanuit MEOS op de VPS.
# Gebruik dezelfde willekeurige waarde (minstens 32 tekens) als MEOS_GOVERNMENT_TOKEN daar.
MEOS_PROFILE_SECRET=
